# Environment for herd-scout-daemon.service
#
# RUST_LOG: tracing-subscriber filter spec.
RUST_LOG=info,iroh=warn,iroh_quinn=warn

# CV_SIDECAR_SOCKET: Unix socket the daemon connects to for inference.
# Must match the sidecar's CV_SIDECAR_SOCKET in herd-scout-cv-sidecar.env.
# (This is also the default in src/cv/model.rs, set explicitly for clarity.)
CV_SIDECAR_SOCKET=/run/herd-scout/cv.sock
