# Environment for herd-scout-cv-sidecar.service
#
# CV_SIDECAR_SOCKET: Unix socket the daemon connects to.
CV_SIDECAR_SOCKET=/run/herd-scout/cv.sock

# CV_SIDECAR_MODEL: ONNX model path. YOLO11s exported with `nms=True` so the
# graph emits a [1, 300, 6] (xyxy, conf, class) tensor — postprocess is just
# a tensor decode. Re-export with:
#   yolo export model=yolo11s.pt format=onnx nms=True opset=17 simplify=True
# Rollback target: /srv/aiworker/yolov5n.onnx (kept on disk pre-Phase 1).
CV_SIDECAR_MODEL=/srv/aiworker/yolo11s.onnx

# MPLCONFIGDIR: supervision pulls matplotlib transitively; matplotlib insists
# on a writable config dir at import time. ProtectHome=read-only shadows the
# default ~/.config/matplotlib, so point it at the runtime tmpdir instead.
MPLCONFIGDIR=/run/herd-scout/.matplotlib

# CV_SIDECAR_GPU_MEM_MIB: hard cap on the CUDA EP's arena (ORT
# `gpu_mem_limit`). Default 256 MiB — empirical floor was 160 MiB at
# 720p (ORT crashes the session at 144 MiB during the embedded-NMS
# ArgMax node), 256 = +50% safety rounded to a power-of-two-friendly
# value. nvidia-smi will report ~340 MiB total VRAM held by the
# sidecar; the gap is model weights, cuDNN workspace, and CUDA stream
# state, none of which gpu_mem_limit constrains. Raise only if input
# resolution grows beyond 720p; lower will OOM mid-inference.
#CV_SIDECAR_GPU_MEM_MIB=256

# CV_SIDECAR_FORCE_CPU: if set to 1/true/yes, skip the CUDA EP entirely
# and run inference on CPU only. Use as an emergency override when GPU
# contention is unworkable (~5 FPS on i7-7700HQ for YOLO11s, slower than
# the 10 FPS daemon cap but still functional). Leave unset for normal
# operation.
#CV_SIDECAR_FORCE_CPU=0

# LD_LIBRARY_PATH: required for onnxruntime-gpu to find CUDA + cuDNN.
# Points at the aiworker venv's pip-installed nvidia/* wheels (cuBLAS,
# cuDNN, cuFFT, cuRAND, cuSOLVER, cuSPARSE, NCCL, NVJITLink, NVTX,
# cudart, cupti, nvrtc). Order doesn't matter; ldconfig picks the
# first match per soname.
LD_LIBRARY_PATH=/srv/aiworker/.venv/lib/python3.10/site-packages/nvidia/cublas/lib:/srv/aiworker/.venv/lib/python3.10/site-packages/nvidia/cuda_cupti/lib:/srv/aiworker/.venv/lib/python3.10/site-packages/nvidia/cuda_nvrtc/lib:/srv/aiworker/.venv/lib/python3.10/site-packages/nvidia/cuda_runtime/lib:/srv/aiworker/.venv/lib/python3.10/site-packages/nvidia/cudnn/lib:/srv/aiworker/.venv/lib/python3.10/site-packages/nvidia/cufft/lib:/srv/aiworker/.venv/lib/python3.10/site-packages/nvidia/curand/lib:/srv/aiworker/.venv/lib/python3.10/site-packages/nvidia/cusolver/lib:/srv/aiworker/.venv/lib/python3.10/site-packages/nvidia/cusparse/lib:/srv/aiworker/.venv/lib/python3.10/site-packages/nvidia/nccl/lib:/srv/aiworker/.venv/lib/python3.10/site-packages/nvidia/nvjitlink/lib:/srv/aiworker/.venv/lib/python3.10/site-packages/nvidia/nvtx/lib
