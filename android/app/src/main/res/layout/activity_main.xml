<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Title -->
    <TextView
        android:id="@+id/appTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textSize="28sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/appSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/app_subtitle"
        android:textSize="14sp"
        android:gravity="center"
        android:alpha="0.7"
        android:layout_marginBottom="32dp" />

    <!-- Camera preview (visible only while streaming so the user knows
         the camera is live; hidden in idle/connected states). -->
    <androidx.camera.view.PreviewView
        android:id="@+id/cameraPreview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="invisible"
        android:layout_marginBottom="16dp" />

    <!-- Action buttons -->
    <Button
        android:id="@+id/scanButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/scan_ticket"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/startStopButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/start_streaming"
        android:enabled="false"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/disconnectButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/disconnect"
        android:enabled="false"
        android:layout_marginBottom="16dp" />

    <!-- Status overlay -->
    <TextView
        android:id="@+id/statusOverlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/status_idle"
        android:textSize="16sp"
        android:padding="12dp"
        android:background="?android:attr/colorBackgroundFloating"
        android:fontFamily="monospace" />
</LinearLayout>

    <!-- Orientation overlay: nudges the user to hold the phone in landscape
         so the encoded video matches CameraX's targetRotation = ROTATION_90.
         Only visible when the device's display rotation is portrait
         (ROTATION_0 / ROTATION_180); hidden in landscape so it doesn't
         nag once the user is correctly oriented. Sits on top of the
         whole screen as a banner across the top. -->
    <TextView
        android:id="@+id/orientationHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:text="@string/orientation_hint"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:gravity="center"
        android:padding="14dp"
        android:background="#CC1976D2"
        android:elevation="8dp"
        android:visibility="gone" />
</FrameLayout>
