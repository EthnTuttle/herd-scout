<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Title -->
    <TextView
        android:id="@+id/appTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textSize="28sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/appSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/app_subtitle"
        android:textSize="14sp"
        android:gravity="center"
        android:alpha="0.7"
        android:layout_marginBottom="32dp" />

    <!-- Camera preview (visible only while streaming so the user knows
         the camera is live; hidden in idle/connected states). -->
    <androidx.camera.view.PreviewView
        android:id="@+id/cameraPreview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="invisible"
        android:layout_marginBottom="16dp" />

    <!-- Action buttons -->
    <Button
        android:id="@+id/scanButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/scan_ticket"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/startStopButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/start_streaming"
        android:enabled="false"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/disconnectButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/disconnect"
        android:enabled="false"
        android:layout_marginBottom="16dp" />

    <!-- Status overlay -->
    <TextView
        android:id="@+id/statusOverlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/status_idle"
        android:textSize="16sp"
        android:padding="12dp"
        android:background="?android:attr/colorBackgroundFloating"
        android:fontFamily="monospace" />
</LinearLayout>

    <!-- Wave 9: top-edge indicator. Persistent corner widget showing
         which physical edge of the phone the user has configured to be
         the "top" of the captured video. The arrow rotates based on the
         saved TopEdge enum (see TopEdge.kt + MainActivity.updateOrientationIndicator).
         Tapping the gear icon opens the picker dialog. Replaces Wave 8's
         "rotate to landscape" banner-nag — the phone no longer needs to
         be physically rotated; the user just declares which edge is up. -->
    <LinearLayout
        android:id="@+id/topEdgeIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="8dp"
        android:layout_margin="8dp"
        android:background="#80000000"
        android:elevation="6dp">

        <ImageView
            android:id="@+id/topEdgeArrow"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_arrow_up"
            android:contentDescription="@string/top_edge_arrow_desc" />

        <TextView
            android:id="@+id/topEdgeLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:fontFamily="monospace" />

        <ImageButton
            android:id="@+id/topEdgeSettings"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@android:drawable/ic_menu_preferences"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/top_edge_settings_desc" />
    </LinearLayout>
</FrameLayout>
